# ============================================================================
# THERMAL & BUSINESS COMMAND CENTER - MAU BIEN MOI TRUONG
# ----------------------------------------------------------------------------
# Copy file nay thanh `.env` o thu muc goc repo roi dien gia tri that:
#     cp .env.example .env
#
# `.env` DA duoc .gitignore chan. TUYET DOI khong commit gia tri that.
# Sinh secret ngau nhien:
#     python -c "import secrets;print(secrets.token_urlsafe(48))"
# Sinh Laravel APP_KEY (Invoice Ninja):
#     python -c "import secrets,base64;print('base64:'+base64.b64encode(secrets.token_bytes(32)).decode())"
# ============================================================================


# ----------------------------------------------------------------------------
# CHUNG: GRAFANA
# ----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=doi_mat_khau_nay
# Stack A va B deu dung Grafana. Neu chay song song 2 stack thi port phai khac nhau.
GRAFANA_PORT=3000
GRAFANA_PORT_B=3001
# Chi bat 2 bien duoi day khi TV kiosk can xem khong dang nhap, va PHAI nam sau reverse proxy co auth.
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_ALLOW_EMBEDDING=false


# ----------------------------------------------------------------------------
# BACKEND TU VIET (FastAPI) - trung tam cua he thong, OSS la nguon du lieu
# ----------------------------------------------------------------------------
API_PORT=8080
# Dev: sqlite:///./thermal_biz.db   |   Prod: postgresql+psycopg2://user:pass@host:5432/db
DATABASE_URL=sqlite:///./thermal_biz.db
JWT_SECRET_KEY=doi_khoa_nay
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Danh sach origin, phan cach bang dau phay. Khong dung "*" khi allow_credentials=true.
# Starlette SO KHOP CHINH XAC tung origin, nen phai liet ke dung chuoi ma trinh duyet/gui len:
#   http://localhost:5173      -> vite dev
#   http://localhost:4173      -> vite preview (PWA build)
#   https://localhost          -> Capacitor Android (androidScheme: "https")
#   capacitor://localhost      -> Capacitor iOS
#   https://<ten-mien-that>    -> them tay khi deploy len mien cong khai
# KHONG them "app://." hay "null": app://. khong phai mot origin hop le; con "null" la origin
# cua moi sandboxed iframe tren internet -> cho phep no la mo cua cho ca trang web la.
# Ban Electron desktop nap tu file:// nen gui Origin: null; xu ly o phia client (xem
# clients/MOBILE_AND_DESKTOP_CLIENTS.md muc 1), khong xu ly bang cach no long CORS o server.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://localhost,capacitor://localhost

# Tu seed du lieu mau khi DB rong (tien dev/demo). Prod dat false.
# docker-compose.yml mac dinh AUTO_SEED=false cho du o day viet true: stack do dung
# Postgres (moi truong that) nen khong duoc tu sinh tai khoan demo.
# AUTO_SEED=true thi SEED_DEMO_PASSWORD bat buoc >= 8 ky tu, neu khong backend tu choi khoi dong.
AUTO_SEED=true
# Mat khau khoi tao cho 3 tai khoan demo: bgd / vanhanh / ketoan. DOI NGAY sau khi dang nhap.
SEED_DEMO_PASSWORD=doi_mat_khau_nay
# Chu ky day du lieu qua WebSocket /ws/telemetry (giay)
TELEMETRY_WS_INTERVAL_SECONDS=3

# Postgres dung khi muon day len prod (SQLite chi de dev khong can cai dat)
POSTGRES_PORT=5432
POSTGRES_DB=thermal_biz_db
POSTGRES_USER=thermal_admin
# Mat khau nay duoc noi thang vao DATABASE_URL (dang postgresql+psycopg2://user:PASS@host/db).
# Ky tu dac biet nhu @ : / # ? se lam URL bi parse sai -> API bao loi ket noi rat kho hieu.
# Sinh bang secrets.token_urlsafe(...) nhu huong dan o dau file thi luon an toan.
POSTGRES_PASSWORD=doi_mat_khau_nay


# ----------------------------------------------------------------------------
# HUONG A: THINGSBOARD (IIoT) + ERPNEXT (ERP & Bao tri)
# ----------------------------------------------------------------------------
TB_PORT=8083
TB_MQTT_PORT=1883
TB_COAP_PORT=5683
TB_POSTGRES_PORT=5433
TB_DB_NAME=thingsboard
TB_DB_USER=tb_user
TB_DB_PASSWORD=doi_mat_khau_nay

ERP_DB_PORT=3306
ERP_DB_NAME=erpnext_db
ERP_DB_USER=erp_user
ERP_DB_PASSWORD=doi_mat_khau_nay
ERP_DB_ROOT_PASSWORD=doi_mat_khau_nay

# URL that ERPNext thuong khong phai ten service DB. Doi lai khi dung ERPNext that.
ERPNEXT_URL=http://erpnext:8000
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

CONNECTOR_A_PORT=8081
CONNECTOR_A_API_KEY=doi_khoa_nay
# true = khong goi ERPNext that, chi log ra. Dung khi chua co ERPNext.
CONNECTOR_A_SIMULATION_MODE=false


# ----------------------------------------------------------------------------
# HUONG B: HOME ASSISTANT (Metering) + INVOICE NINJA (Billing)
# ----------------------------------------------------------------------------
HASS_PORT=8123
HASS_URL=http://homeassistant:8123
# Long-lived access token: HA > Profile > Long-Lived Access Tokens
HASS_TOKEN=

NINJA_DB_PORT=3307
NINJA_DB_NAME=ninja
NINJA_DB_USER=ninja
NINJA_DB_PASSWORD=doi_mat_khau_nay
NINJA_DB_ROOT_PASSWORD=doi_mat_khau_nay

INVOICE_NINJA_PORT=8088
INVOICE_NINJA_URL=http://invoiceninja:80
INVOICE_NINJA_TOKEN=
INVOICE_NINJA_APP_KEY=

CONNECTOR_B_PORT=8082
CONNECTOR_B_API_KEY=doi_khoa_nay
# true = khong goi HA / Invoice Ninja that, chi log ra. Dung khi demo.
CONNECTOR_B_SIMULATION_MODE=false
# Don gia dich vu bao quan lanh (VND/kWh). Nam phia server, nguoi goi API khong tu khai duoc.
SERVICE_RATE_PER_KWH=3500

# Khoa cac endpoint /api/ingest/* cua backend. Connector A/B gui header X-Connector-Api-Key.
# De trong => backend tu choi nhan du lieu (503), khong bao gio mo cong.
CONNECTOR_API_KEY=doi_khoa_nay

# Bang anh xa tenant_code -> Invoice Ninja client_id (JSON).
# client_id KHONG duoc phep do nguoi goi API tu khai.
TENANT_CLIENT_MAP={"THUE-ANPHAT":"1","THUE-HOANGGIA":"2"}

# Don gia dien EVN (VND/kWh) - se duoc thay bang bang TOU 3 khung gio
ELECTRICITY_RATE_VND=2500
