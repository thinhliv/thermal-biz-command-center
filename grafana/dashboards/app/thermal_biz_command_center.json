          "rawSql": "SELECT c.name AS \"Khách hàng\",\n               SUM(GREATEST(0, r.amount_vnd - r.paid_amount_vnd)) AS \"Nợ quá hạn\"\n        FROM receivables r\n        JOIN customers c ON c.id = r.customer_id\n        WHERE r.status IN ('OPEN', 'PARTIAL')\n          AND r.due_at <= (now() AT TIME ZONE 'utc') - interval '1 day'\n        GROUP BY c.name\n        HAVING SUM(GREATEST(0, r.amount_vnd - r.paid_amount_vnd)) > 0\n        ORDER BY 2 DESC\n        LIMIT 10",
