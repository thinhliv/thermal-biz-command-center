          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN SUM(revenue_vnd) > 0\n               THEN ROUND(100.0 * (SUM(revenue_vnd)\n                     - SUM(electricity_cost_vnd + refrigerant_cost_vnd + labor_cost_vnd\n                           + maintenance_cost_vnd + overhead_cost_vnd)) / SUM(revenue_vnd), 1)\n               END AS \"Biên LN gộp\"\n        FROM service_orders\n        WHERE status <> 'CANCELLED'",
