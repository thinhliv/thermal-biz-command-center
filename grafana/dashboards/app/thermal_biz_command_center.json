      "id": 10,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "thermal_biz_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG(latest.cop)::numeric, 2) AS \"COP\"\n        FROM equipment e\n        CROSS JOIN LATERAL (\n            SELECT s.cop\n            FROM telemetry_samples s\n            WHERE s.equipment_id = e.id\n            ORDER BY s.ts DESC\n            LIMIT 1\n        ) latest\n        WHERE e.is_active\n          AND e.kind <> 'BOILER'\n          AND latest.cop IS NOT NULL",
          "refId": "A"
        }
      ],
      "title": "COP trung bình (mẫu mới nhất)",
      "type": "gauge",
      "description": "COP = Q_o/N_e, backend tính lại lúc ingest chứ không tin giá trị thiết bị gửi lên. Đây là trung bình COP của MẪU MỚI NHẤT từng thiết bị lạnh đang hoạt động — đúng định nghĩa `avg_cop` của `/api/thermal/summary`. Lò hơi không có COP, nó dùng η (%) là một đại lượng khác hẳn.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
