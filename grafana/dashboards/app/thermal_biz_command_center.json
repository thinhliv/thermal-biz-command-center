      "id": 12,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "thermal_biz_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.code AS \"Mã\",\n           e.name AS \"Thiết bị\",\n           e.kind AS \"Loại\",\n           e.location AS \"Vị trí\",\n           latest.ts AT TIME ZONE 'UTC' AS \"Cập nhật lúc\",\n           ROUND(latest.temperature_c::numeric, 2) AS \"Nhiệt độ (°C)\",\n           ROUND(latest.cop::numeric, 2) AS \"COP\",\n           ROUND(e.design_cop::numeric, 2) AS \"COP thiết kế\",\n           ROUND(latest.efficiency_pct::numeric, 1) AS \"Hiệu suất η (%)\",\n           ROUND(latest.vibration_mm_s::numeric, 2) AS \"Rung (mm/s)\",\n           ROUND(latest.power_kw::numeric, 1) AS \"Công suất (kW)\",\n           latest.status AS \"Trạng thái\"\n    FROM equipment e\n    LEFT JOIN LATERAL (\n        SELECT s.ts, s.temperature_c, s.cop, s.efficiency_pct, s.vibration_mm_s, s.power_kw, s.status\n        FROM telemetry_samples s\n        WHERE s.equipment_id = e.id\n        ORDER BY s.ts DESC\n        LIMIT 1\n    ) latest ON true\n    WHERE e.is_active\n    ORDER BY e.code",
          "refId": "A"
        }
      ],
      "title": "Thiết bị & chỉ số mới nhất",
      "type": "table",
      "description": "Mỗi thiết bị một dòng, lấy mẫu telemetry mới nhất. Rung > 4,5 mm/s là vùng C/D theo ISO 10816-3. Lò hơi chỉ có cột η, máy lạnh chỉ có cột COP — hai đại lượng này không thay thế nhau được.",
      "fieldConfig": {
        "defaults": {
