          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.severity AS \"Mức độ\",\n           COALESCE(e.name, '(không gắn thiết bị)') AS \"Thiết bị\",\n           a.metric AS \"Chỉ số\",\n           ROUND(a.observed_value::numeric, 2) AS \"Giá trị đo\",\n           a.threshold AS \"Ngưỡng\",\n           a.message AS \"Nội dung\",\n           CASE WHEN a.is_haccp THEN 'CÓ' ELSE '' END AS \"HACCP\",\n           CASE WHEN a.acknowledged_at IS NULL THEN 'CHƯA' ELSE 'RỒI' END AS \"Đã xác nhận\",\n           a.raised_at AT TIME ZONE 'UTC' AS \"Lúc phát sinh\"\n    FROM alerts a\n    LEFT JOIN equipment e ON e.id = a.equipment_id\n    WHERE a.cleared_at IS NULL\n    ORDER BY CASE a.severity WHEN 'CRITICAL' THEN 0 WHEN 'MAJOR' THEN 1\n                             WHEN 'WARNING' THEN 2 ELSE 3 END,\n             a.raised_at DESC",
