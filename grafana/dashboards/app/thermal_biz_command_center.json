          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT x.label AS \"Khoản mục\", x.value AS \"value\"\n        FROM (\n            SELECT SUM(electricity_cost_vnd)   AS e,\n                   SUM(refrigerant_cost_vnd)   AS r,\n                   SUM(labor_cost_vnd)         AS l,\n                   SUM(maintenance_cost_vnd)   AS m,\n                   SUM(overhead_cost_vnd)      AS o\n            FROM service_orders\n            WHERE status <> 'CANCELLED'\n        ) s\n        CROSS JOIN LATERAL (VALUES\n            ('Tiền điện',     s.e),\n            ('Môi lạnh',      s.r),\n            ('Nhân công',     s.l),\n            ('Bảo trì',       s.m),\n            ('Chi phí chung', s.o)\n        ) AS x(label, value)\n        WHERE x.value > 0\n        ORDER BY x.value DESC",
          "refId": "A"
        }
      ],
      "title": "Cơ cấu giá vốn (luỹ kế)",
