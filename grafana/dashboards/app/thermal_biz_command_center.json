          "rawQuery": true,
          "rawSql": "SELECT b.tenant_code AS \"Khách thuê\",\n               b.period_start AT TIME ZONE 'UTC' AS \"Từ\",\n               b.period_end   AT TIME ZONE 'UTC' AS \"Đến\",\n               ROUND(b.total_kwh::numeric, 1)    AS \"Tổng kWh\",\n               ROUND(b.peak_kwh::numeric, 1)     AS \"Cao điểm\",\n               ROUND(b.normal_kwh::numeric, 1)   AS \"Bình thường\",\n               ROUND(b.off_peak_kwh::numeric, 1) AS \"Thấp điểm\",\n               b.electricity_vnd  AS \"Tiền điện\",\n               b.service_fee_vnd  AS \"Phí dịch vụ\",\n               b.total_vnd        AS \"Tổng cộng\",\n               COALESCE(b.external_invoice_id, '(nội bộ)') AS \"Invoice Ninja\"\n        FROM billed_invoices b\n        ORDER BY b.period_end DESC\n        LIMIT 50",
          "refId": "A"
        }
