        {
          "datasource": {
            "type": "postgres",
            "uid": "thermal_biz_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH open_inv AS (\n            SELECT GREATEST(0, r.amount_vnd - r.paid_amount_vnd) AS outstanding,\n                   GREATEST(0, FLOOR(EXTRACT(EPOCH FROM ((now() AT TIME ZONE 'utc') - r.due_at)) / 86400))::int AS overdue_days\n            FROM receivables r\n            WHERE r.status IN ('OPEN', 'PARTIAL')\n        )\n        SELECT CASE WHEN overdue_days = 0   THEN '0. Trong hạn'\n                    WHEN overdue_days <= 30 THEN '1. 1-30 ngày'\n                    WHEN overdue_days <= 60 THEN '2. 31-60 ngày'\n                    WHEN overdue_days <= 90 THEN '3. 61-90 ngày'\n                    ELSE '4. Trên 90 ngày' END AS \"Nhóm tuổi nợ\",\n               SUM(outstanding) AS \"Số tiền\"\n        FROM open_inv\n        GROUP BY 1\n        ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Tuổi nợ",
