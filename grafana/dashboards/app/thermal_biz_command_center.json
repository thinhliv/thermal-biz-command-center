          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(o.started_at, '1d'),\n               SUM(o.revenue_vnd) AS \"Doanh thu\",\n               SUM(o.electricity_cost_vnd) AS \"Tiền điện\"\n        FROM service_orders o\n        WHERE o.status <> 'CANCELLED'\n          AND $__timeFilter(o.started_at)\n        GROUP BY 1\n        ORDER BY 1",
          "refId": "A"
        }
